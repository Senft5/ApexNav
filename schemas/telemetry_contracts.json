{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "definitions": {
    "RawSensorFrame": {
      "type": "object",
      "required": [
        "t_sec",
        "ax",
        "ay",
        "az",
        "gx",
        "gy",
        "gz",
        "v_mps",
        "lat",
        "lon"
      ],
      "properties": {
        "t_sec": {
          "type": "number"
        },
        "ax": {
          "type": "number"
        },
        "ay": {
          "type": "number"
        },
        "az": {
          "type": "number"
        },
        "gx": {
          "type": "number"
        },
        "gy": {
          "type": "number"
        },
        "gz": {
          "type": "number"
        },
        "v_mps": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "alt_m": {
          "type": "number"
        }
      }
    },
    "RoadSegment5m": {
      "type": "object",
      "required": [
        "segment_index",
        "distance_m",
        "lat",
        "lon",
        "elevation_m",
        "grade_pct",
        "camber_deg",
        "crest_vertical_g",
        "roughness_rms",
        "engagement_score"
      ],
      "properties": {
        "segment_index": {
          "type": "integer"
        },
        "distance_m": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "elevation_m": {
          "type": "number"
        },
        "grade_pct": {
          "type": "number"
        },
        "camber_deg": {
          "type": [
            "number",
            "null"
          ],
          "description": "Turn-relative banking: + = banked into the corner, - = off-camber. null where not cornering (unobservable; the live pipeline holds a corner's value 1 s, then null), never 0."
        },
        "camber_v": {
          "type": [
            "integer",
            "null"
          ],
          "description": "2 when camber_deg comes from the fixed live pipeline (ApexKit IMUPipeline.camberVersion). Rows, frames and uploads without it come from builds that decayed camber to a placeholder 0, and their camber is not shared."
        },
        "crest_vertical_g": {
          "type": "number",
          "description": "Low-passed (< 1 Hz) vertical acceleration with gravity removed, in g (the pipeline's m/s^2 over 9.80665): negative when the car goes light over a crest. Uploads send the bin's peak unweighting, max(0, -min), clamped to 0..3 (web/contributor.js); the server keeps that peak (backend/src/contribute.ts)."
        },
        "roughness_rms": {
          "type": "number"
        },
        "engagement_score": {
          "type": "number"
        },
        "vert_peak_g": {
          "type": "number",
          "description": "Peak |>8 Hz vertical| in the bin, g. Pothole/bump spike source (>0.35 g)."
        },
        "t_s": {
          "type": [
            "number",
            "null"
          ],
          "description": "Seconds since the drive started at this sample, from the fixes' own clock (a stop counts). Kept on the phone to line up a drive video (web/recording.js timesOf); never uploaded. null where a fix had no time."
        },
        "target_mph": {
          "type": "number",
          "description": "Braking envelope from core/road_dna.py (mu_eff 0.60, 0.5 g decel, 70 mph cap)."
        }
      }
    },
    "RoadEvent": {
      "type": "object",
      "required": [
        "type",
        "code",
        "call",
        "index",
        "dist_m",
        "lat",
        "lon"
      ],
      "properties": {
        "type": {
          "enum": [
            "corner",
            "bump",
            "crest",
            "dip",
            "alpr"
          ]
        },
        "code": {
          "type": "string",
          "description": "L1-L6/R1-R6/LHP/RHP, BUMP, CREST, DIP, LPR"
        },
        "call": {
          "type": "string",
          "description": "Spoken pace note, e.g. \"Left 4 tightens, over crest\""
        },
        "index": {
          "type": "integer"
        },
        "dist_m": {
          "type": "number"
        },
        "lat": {
          "type": "number"
        },
        "lon": {
          "type": "number"
        },
        "radius_m": {
          "type": "number"
        },
        "apex_mph": {
          "type": "number"
        },
        "severity_g": {
          "type": "number"
        }
      },
      "description": "Every event is measured (IMU) or derived from geometry/OSM. alpr events come only from OpenStreetMap surveillance:type=ALPR."
    },
    "StageSector": {
      "type": "object",
      "required": [
        "id",
        "start_index",
        "end_index",
        "tech",
        "flow",
        "surf",
        "clear"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "start_index": {
          "type": "integer"
        },
        "end_index": {
          "type": "integer"
        },
        "start_m": {
          "type": "number"
        },
        "end_m": {
          "type": "number"
        },
        "corners": {
          "type": "integer"
        },
        "tech": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "flow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "surf": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "clear": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 100,
          "description": "null = no ALPR data; never treated as clear"
        }
      }
    },
    "AudioBusFrame": {
      "description": "One frame of the audio bus (core/audio_bus.py, web/audio_bus.js): what the sound engine follows. null means not measured: the engine rests on its pad.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engagement",
        "intensity",
        "anticipation",
        "energy",
        "cutoff_hz",
        "layers",
        "swell",
        "master",
        "calm"
      ],
      "properties": {
        "engagement": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "intensity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "anticipation": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "energy": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "cutoff_hz": {
          "type": "number",
          "minimum": 380,
          "maximum": 11000
        },
        "layers": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "pad",
            "pulse",
            "bass",
            "lead"
          ],
          "properties": {
            "pad": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "pulse": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "bass": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "lead": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          }
        },
        "swell": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "master": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "calm": {
          "type": "boolean"
        }
      }
    }
  }
}
