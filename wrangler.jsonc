{
  // Cloudflare Worker "apexnav": static site from web/, plus the API (backend/src) on /api/*.
  // run_worker_first sends only /api/* to the Worker; every other path is served straight from web/.
  // Secrets (set in the Cloudflare dashboard, never in this file): GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, OWNER_EMAIL, PEPPER.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "apexnav",
  "main": "backend/src/index.ts",
  "compatibility_date": "2026-10-19",
  "observability": { "enabled": true },
  "assets": { "directory": "./web", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "apexnav-db", "database_id": "b0c559d5-48c2-462c-bd97-cf375233f7c1", "migrations_dir": "backend/migrations" }
  ]
}
