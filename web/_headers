# Headers for the Cloudflare Worker's static assets (wrangler.jsonc assets.directory).
# The full Content-Security-Policy is a <meta> tag in each page (tools/csp.py, IDEAS Z-11), so it also holds in the iOS shell;
# frame-ancestors only works as a header, so it stays here.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), accelerometer=(self), gyroscope=(self), camera=(), microphone=()
  X-Robots-Tag: noindex

/voices/*
  Cache-Control: public, max-age=31536000, immutable

/vendor/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=3600

/g2p/*
  Cache-Control: public, max-age=604800

/sw.js
  Cache-Control: no-cache
