{
  // Used only by vitest: the same Worker, a throw-away local D1, test secrets.
  "name": "apexnav-test",
  "main": "./src/index.ts",
  "compatibility_date": "2026-10-19",
  "durable_objects": { "bindings": [{ "name": "CONVOY", "class_name": "ConvoyRoom" }, { "name": "CONVOY_INDEX", "class_name": "ConvoyIndex" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ConvoyRoom", "ConvoyIndex"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "apexnav-test", "database_id": "00000000-0000-0000-0000-000000000000" },
    { "binding": "RESTORE_TEST", "database_name": "apexnav-restore-test", "database_id": "00000000-0000-0000-0000-000000000001" }
  ],
  "kv_namespaces": [{ "binding": "BACKUPS", "id": "00000000000000000000000000000000" }, { "binding": "PHOTOS", "id": "00000000000000000000000000000001" }, { "binding": "CTX", "id": "00000000000000000000000000000002" }],
  "r2_buckets": [{ "binding": "ARCHIVE_TEST", "bucket_name": "apexnav-archive-test" }, { "binding": "DATA", "bucket_name": "apexnav-data-test" }, { "binding": "MEDIA", "bucket_name": "apexnav-media-test" }, { "binding": "DEV_DRIVES", "bucket_name": "apexnav-devdrives-test" }],
  "vars": { "GOOGLE_CLIENT_ID": "test-client", "GOOGLE_CLIENT_SECRET": "test-secret", "OWNER_EMAIL": "owner@example.test", "PEPPER": "test-pepper", "PUBLIC_ORIGIN": "https://apexnav.test", "REVIEW_INVITE_HASH": "5f48f2f96660bcebf73f3d53ab9cd4645eeedb54e9a04c40800fc358c47ac15e", "DEV_FINGERPRINTS": "982c50c806e5c861", "DEV_DRIVES_READ_HASH": "cacb3f98f9b6c90e58a53cd76a768b1e8174f2b055aa9e5c9e669444db26f330", "QUERY_LIMIT": "50", "REALTIME_APP_ID": "test-app", "REALTIME_APP_TOKEN": "test-token", "DATA_OWNER_KEYS": "3ce6949592125d62171f11b4ab32d10582c1730db50871431a6ab88c2704e6f5", "DATA_API_KEYS": "23dcc01c380317451a5b17cdad3c8222b2c7cb85ff8e6335c587ffb99c090a9b" }
}
